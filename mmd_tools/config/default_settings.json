{
  "import": {
    "_comment": "Settings related to importing files (PMX, PMD, VMD)",
    "general": {
      "_comment": "General import settings that affect the overall process",
      "scale_factor": 1.0,
      "use_namespace": false
    },
    "model": {
      "_comment": "Settings for model geometry, materials, and structure",
      "import_models": true,
      "separate_meshes_by_material": false,
      "auto_resolve_textures": true,
      "create_mmd_shaders": true,
      "create_mmd_control_rig": false,
      "mmd_shader_backend": "auto",
      "texture_search_path": "",
      "show_texture_issue_dialog": true,
      "uv_set_name": "map#",
      "disable_backface_culling": true
    },
    "physics": {
      "_comment": "Settings for importing physics elements like rigid bodies and joints",
      "import_physics": true
    },
    "morph": {
      "_comment": "Settings for importing morphs (blend shapes)",
      "import_morphs": true
    },
    "rig": {
      "_comment": "Settings for rigging system setup",
      "add_semi_standard_bones": false,
      "bake_mode": false
    },
    "animation": {
      "_comment": "Settings for importing VMD animation files",
      "import_animations": true,
      "import_morph_animation": true,
      "animation_start_frame": 1,
      "vmd_fps": 30,
      "motion_scale": 1.0,
      "clear_existing_motion": false,
      "vmd_rotation_time_curve": true,
      "resample_curves": false,
      "use_native_physics_bake": false,
      "reduce_bake_keys": false,
      "reduce_quality": 1.0,
      "import_camera_animation": true,
      "import_light_animation": true,
      "use_mmd_runtime_bake": true,
      "static_channel_epsilon_translate": 0.0001,
      "static_channel_epsilon_rotate_deg": 0.01
    },
    "native": {
      "_comment": "Development Mode settings for native and compiled import paths",
      "use_cpp_fast_load": false,
      "cpp_fast_load_mesh_only": true,
      "use_cpp_vp2_ownership": false,
      "require_native_pmx_parse": true,
      "use_cpp_rig_nodes": false
    },
    "naming": {
      "_comment": "Settings that control how objects are named in Maya",
      "translate_names": true,
      "translation_dictionary": ""
    }
  },
  "export": {
    "_comment": "Settings related to exporting to MMD formats",
    "general": {
      "_comment": "General export settings",
      "apply_scale": true
    }
  },
  "ui": {
    "_comment": "Settings for the plugin user interface",
    "general": {
      "show_advanced_options": false,
      "development_mode": false,
      "file_history_limit": 20,
      "language": "ja"
    },
    "dev": {
      "command_port": 3939
    }
  },
  "logging": {
    "_comment": "Settings for the logging system",
    "enabled": true,
    "level": "WARNING",
    "log_file_path": "logs/mmd_tools.log"
  }
}
