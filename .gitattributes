# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Python files
*.py text eol=lf
*.pyw text eol=lf

# Configuration files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf

# Documentation
*.md text eol=lf
*.rst text eol=lf
*.txt text eol=lf
README text eol=lf
LICENSE text eol=lf

# Scripts
*.sh text eol=lf
*.bash text eol=lf

# Maya module file
*.mod text eol=lf

# Git files
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files (images, caches)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.pyc binary
*.pyd binary
*.pyo binary
*.db binary
*.sqlite binary

# Native binaries — Git LFS
*.dll filter=lfs diff=lfs merge=lfs -text
*.so filter=lfs diff=lfs merge=lfs -text
*.dylib filter=lfs diff=lfs merge=lfs -text
*.mll filter=lfs diff=lfs merge=lfs -text
*.bundle filter=lfs diff=lfs merge=lfs -text
*.pdb filter=lfs diff=lfs merge=lfs -text

# Maya files
*.ma binary
*.mb binary
*.mel binary

# MMD files
*.pmd binary
*.pmx binary
*.vmd binary
*.vpd binary
